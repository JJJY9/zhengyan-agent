# 复制为 .env 后按需填写。Docker 启动时 MONGO_URI 会被 docker-compose.yml 覆盖为 mongodb://mongo:27017

# 大模型（DeepSeek，OpenAI 兼容接口）。不填也能启动并浏览演示数据，但不能发起新研究
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 宿主机直接运行（不用 Docker 跑后端）时使用
MONGO_URI=mongodb://localhost:27017
MONGO_DB=advisor

# 访问账号密码（可选）：设置 AUTH_PASSWORD 后整站需要登录。
# 对外分享/部署到服务器时必须设置；建议经 HTTPS 反向代理访问并设 AUTH_COOKIE_SECURE=true
AUTH_USER=admin
AUTH_PASSWORD=
AUTH_COOKIE_SECURE=false

# 本地决策小模型（Kev，接口同 OpenAI 兼容的 /v1/systemone）。为空则意图识别和路由判别只用大模型。
# 宿主机直接运行：http://127.0.0.1:8009 ；后端在 Docker 里、Kev 在宿主机：http://host.docker.internal:8009
DECISION_BASE_URL=
DECISION_MODEL=kev-latest
DECISION_API_KEY=local

# 反向代理部署时填反向代理地址（如 172.18.0.1），否则登录限速会把所有访客算成同一个来源 IP。
# 反代必须剥离客户端自带的 X-Forwarded-For，只让代理写入真实客户端 IP。
# FORWARDED_ALLOW_IPS=127.0.0.1

# 构建镜像时的下载源（国内网络可改成镜像源，例如下面两行）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# NPM_REGISTRY=https://registry.npmmirror.com
